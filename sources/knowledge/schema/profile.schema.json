{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "profile.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "name_i18n", "type", "cost", "experience", "characteristics", "equipment_lists", "skill_access", "rules", "source"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
    "name": {"type": "string", "minLength": 1},
    "name_i18n": {
      "type": "object",
      "required": ["en", "es"],
      "properties": {"en": {"type": ["string", "null"]}, "es": {"type": ["string", "null"]}}
    },
    "type": {"enum": ["hero", "henchman"]},
    "cost": {"type": "integer", "minimum": 0},
    "cost_variants": {
      "type": "object",
      "additionalProperties": {"type": "integer", "minimum": 0}
    },
    "experience": {"type": "integer", "minimum": 0},
    "characteristics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["M", "WS", "BS", "S", "T", "W", "I", "A", "Ld"],
      "properties": {
        "M": {
          "oneOf": [
            {"type": "integer", "minimum": 0},
            {"type": "string", "pattern": "^[0-9]+D[0-9]+([+-][0-9]+)?$"}
          ]
        }, "WS": {"type": "integer", "minimum": 0},
        "BS": {"type": "integer", "minimum": 0}, "S": {"type": "integer", "minimum": 0},
        "T": {"type": "integer", "minimum": 0}, "W": {"type": "integer", "minimum": 0},
        "I": {"type": "integer", "minimum": 0}, "A": {"type": "integer", "minimum": 0},
        "Ld": {"type": ["integer", "null"], "minimum": 0}
      }
    },
    "equipment_lists": {"type": "array", "items": {"type": "string"}},
    "fixed_equipment": {"type": "array", "items": {"type": "string"}},
    "equipment_restrictions": {"type": "array", "items": {"type": "string"}},
    "skill_access": {"type": "array", "items": {"type": "string"}},
    "skill_access_variants": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {"type": "string"}
      }
    },
    "rules": {"type": "array", "items": {"$ref": "rule.schema.json"}},
    "source": {"$ref": "source.schema.json"}
  }
}
