{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "catalog-record.schema.json",
  "title": "Registro de regla o equipo de Trollheim",
  "type": "object",
  "required": ["id", "kind", "name", "rule_summary", "source"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
    "kind": {"type": "string"},
    "name": {"type": "string", "minLength": 1},
    "category": {"type": "string"},
    "rule_summary": {"type": "string"},
    "source": {"type": ["string", "object", "null"]},
    "transcription": {"enum": ["verbatim", "summary", "ocr"]},
    "implemented": {"type": ["boolean", "null"]}
  },
  "additionalProperties": true
}
