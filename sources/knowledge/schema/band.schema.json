{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "band.schema.json",
  "title": "Mordheim Combat Lab canonical warband",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "canonical_family", "name", "name_i18n", "original_locale", "categories", "collections", "grade", "setting", "publication", "status", "sources", "roster", "equipment_lists", "profiles", "band_rules", "source_sections"],
  "properties": {
    "schema_version": {"const": 1},
    "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
    "canonical_family": {"type": "string", "pattern": "^[a-z0-9-]+$"},
    "name": {"type": "string", "minLength": 1},
    "name_i18n": {"$ref": "#/$defs/translation"},
    "original_locale": {"enum": ["en", "es"]},
    "categories": {"type": "array", "items": {"enum": ["core", "1a", "1b", "1c", "trollheim"]}, "uniqueItems": true},
    "collections": {"type": "array", "items": {"enum": ["mordheimer", "trollheim"]}, "minItems": 1, "uniqueItems": true},
    "grade": {"enum": ["core", "1a", "1b", "1c", null]},
    "setting": {"type": ["string", "null"]},
    "publication": {"type": ["string", "null"]},
    "status": {"type": "string", "minLength": 1},
    "sources": {"type": "array", "items": {"$ref": "source.schema.json"}, "minItems": 1},
    "roster": {"type": "object", "required": ["minimum_models", "maximum_models", "starting_gold", "members"]},
    "equipment_lists": {"type": "array", "items": {"type": "object", "required": ["id", "name", "name_i18n", "items", "source"]}},
    "profiles": {"type": "array", "minItems": 1, "items": {"$ref": "profile.schema.json"}},
    "band_rules": {"type": "array", "items": {"$ref": "rule.schema.json"}},
    "source_sections": {"type": "array"}
  },
  "$defs": {
    "translation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["en", "es"],
      "properties": {"en": {"type": ["string", "null"]}, "es": {"type": ["string", "null"]}}
    }
  }
}
